# ── Axiom configuration ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Every key is documented. See README.md for full provider preset list.

# ── LLM provider ────────────────────────────────────────────────────────────
# Which adapter to use: openai_compatible | anthropic | gemini
# Default: openai_compatible, pointed at DeepSeek (cheapest reliable paid option,
# ~$3/year at 1 paper/day — see plan.md Q1 for the cost analysis).
LLM_PROVIDER=openai_compatible

# Base URL for the OpenAI-compatible /v1/chat/completions endpoint.
# Only used when LLM_PROVIDER=openai_compatible.
LLM_BASE_URL=https://api.deepseek.com/v1

# Model name understood by the provider.
LLM_MODEL=deepseek-chat

# API key for the selected provider. Get one at platform.deepseek.com.
LLM_API_KEY=sk-your-deepseek-key-here

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ── Provider presets (uncomment ONE block, comment out the DeepSeek block above) ──
#
# Gemini (native adapter, free tier available):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-2.5-flash-lite
#   LLM_API_KEY=your-gemini-key
#
# Anthropic (native adapter — requires an API key, NOT a Pro/Max subscription;
# see plan.md Q1 for why OAuth/subscription auth cannot power automation):
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-haiku-4-5
#   LLM_API_KEY=sk-ant-...
#
# Groq (OpenAI-compatible):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
#
# OpenRouter free tier (OpenAI-compatible):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   LLM_API_KEY=sk-or-...
#
# Ollama, fully local/offline (OpenAI-compatible):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5-coder:14b
#   LLM_API_KEY=ollama
#
# LM Studio, fully local/offline (OpenAI-compatible):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_MODEL=your-loaded-model-name
#   LLM_API_KEY=lm-studio

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1

# ── Scheduling ───────────────────────────────────────────────────────────────
# Timezone in which "today" is computed, independent of machine TZ.
APP_TIMEZONE=Asia/Kolkata
# Cron expression (in APP_TIMEZONE) for the daily generation run.
DAILY_CRON=30 0 * * *

# ── External APIs (all free, but a contact email is required by Unpaywall) ──
UNPAYWALL_EMAIL=you@example.com
# Optional: raises Semantic Scholar rate limits from the shared unauthenticated
# pool (5000 req/5min) to 1-10 req/s. Get one at semanticscholar.org/product/api.
SEMANTIC_SCHOLAR_API_KEY=

# ── Paths ────────────────────────────────────────────────────────────────────
DB_PATH=./data/axiom.db
PDF_CACHE_DIR=./data/pdf-cache
CANON_PATH=./data/canon.json
NEWS_IMAGE_CACHE_DIR=./data/news-image-cache
